# Supabase — the app talks to Postgres, auth, and storage through these
# at runtime (see lib/supabase/*.ts). Find both under your Supabase
# project's Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Used only by Prisma for schema migrations (npm run db:migrate / db:studio).
# The app itself queries through the Supabase client above, not through
# Prisma at runtime — this is purely the migration/schema-management path.
# Find this under Settings → Database → Connection string (use the
# "connection pooling" URL for serverless, direct URL for migrations).
DATABASE_URL=postgresql://postgres:[password]@[host]:5432/postgres
