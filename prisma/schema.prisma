// Prisma schema for swap-app
// Run `npx prisma migrate dev --name init` after setting DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Mirrors Supabase's auth.users table (id is the Supabase auth user id).
model Profile {
  id        String   @id @default(uuid())
  username  String   @unique
  fullName  String?
  avatarUrl String?
  bio       String?
  location  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listings       Listing[]
  wishlist       WishlistItem[]
  sentRequests   SwapRequest[]     @relation("RequestSender")
  receivedRequests SwapRequest[]   @relation("RequestReceiver")
  ratingsGiven   Rating[]          @relation("RatingAuthor")
  ratingsReceived Rating[]         @relation("RatingSubject")
  notifications  Notification[]
  conversations  ConversationParticipant[]
  messages       Message[]

  @@map("profiles")
}

enum ListingStatus {
  AVAILABLE
  PENDING
  SWAPPED
}

model Listing {
  id             String        @id @default(uuid())
  owner          Profile       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId        String
  title          String
  description    String
  category       String
  condition      String
  imageUrl       String?
  wantedInReturn String?
  status         ListingStatus @default(AVAILABLE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  wishedBy       WishlistItem[]
  swapRequests   SwapRequest[]

  @@index([ownerId])
  @@index([category])
  @@map("listings")
}

model WishlistItem {
  id        String   @id @default(uuid())
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String
  createdAt DateTime @default(now())

  @@unique([profileId, listingId])
  @@map("wishlist_items")
}

enum SwapRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  COMPLETED
}

model SwapRequest {
  id           String             @id @default(uuid())
  listing      Listing            @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId    String
  sender       Profile            @relation("RequestSender", fields: [senderId], references: [id], onDelete: Cascade)
  senderId     String
  receiver     Profile            @relation("RequestReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  receiverId   String
  offeredItem  String?
  status       SwapRequestStatus  @default(PENDING)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  conversation Conversation?

  @@index([senderId])
  @@index([receiverId])
  @@map("swap_requests")
}

model Conversation {
  id            String                    @id @default(uuid())
  swapRequest   SwapRequest?              @relation(fields: [swapRequestId], references: [id], onDelete: Cascade)
  swapRequestId String?                   @unique
  createdAt     DateTime                  @default(now())

  participants  ConversationParticipant[]
  messages      Message[]

  @@map("conversations")
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  profile        Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId      String

  @@unique([conversationId, profileId])
  @@map("conversation_participants")
}

model Message {
  id             String       @id @default(uuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  sender         Profile      @relation(fields: [senderId], references: [id], onDelete: Cascade)
  senderId       String
  body           String
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@map("messages")
}

model Rating {
  id        String   @id @default(uuid())
  author    Profile  @relation("RatingAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
  subject   Profile  @relation("RatingSubject", fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId String
  score     Int      // 1-5
  comment   String?
  createdAt DateTime @default(now())

  @@index([subjectId])
  @@map("ratings")
}

enum NotificationType {
  SWAP_REQUEST
  MESSAGE
  RATING
  SYSTEM
}

model Notification {
  id        String           @id @default(uuid())
  profile   Profile          @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId String
  type      NotificationType
  title     String
  body      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([profileId])
  @@map("notifications")
}
